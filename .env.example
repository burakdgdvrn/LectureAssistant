# ============================================================================
# LectureAssistant — Ortam Değişkenleri Şablonu (.env.example)
# ============================================================================
# UYARI: Bu dosyaya gerçek API anahtarları (secret) EKLEMEYİN.
# Geliştirme ortamında bu dosyayı `.env` adıyla kopyalayın ve yalnızca yerel
# `.env` dosyanıza kendi anahtarlarınızı girin. `.env` dosyası Git tarafından
# yoksayılmaktadır (.gitignore).

# ----------------------------------------------------------------------------
# 1. Uygulama ve Sunucu Ayarları
# ----------------------------------------------------------------------------
APP_ENV=development
BACKEND_PORT=8000
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# 2. Ses Yükleme ve Saklama Politikaları (audio/ & storage/)
# ----------------------------------------------------------------------------
MAX_AUDIO_UPLOAD_MB=100
ALLOWED_AUDIO_FORMATS=mp3,wav,m4a,ogg,webm
STORAGE_BASE_DIR=./.local_storage
TEMP_FILE_TTL_MINUTES=60

# ----------------------------------------------------------------------------
# 3. ASR / Speech-to-Text Sağlayıcı Seçimi (providers/asr/)
# Değerlendirilen adaylar: gemini | groq | openai
# ----------------------------------------------------------------------------
ASR_PROVIDER=groq
ASR_TIMEOUT_SECONDS=120

# ----------------------------------------------------------------------------
# 4. LLM Sağlayıcı Seçimi (providers/llm/)
# Değerlendirilen adaylar: gemini | openai | groq | cerebras
# ----------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=60

# ----------------------------------------------------------------------------
# 5. Sağlayıcı API Anahtarları (Yalnızca Sunucu Tarafında Okunur!)
# Kesinlikle frontend koduna veya istemci ortam değişkenlerine aktarmayın.
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

